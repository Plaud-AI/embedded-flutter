# Compile-time credentials — pass with: flutter run --dart-define-from-file=.env
# Get these from https://platform.plaud.ai/developer/portal
# ⚠️ DEMO ONLY: these are baked into the app binary. In production, mint the
# user token and proxy upload/transcription through your backend.

# Per-user JWT used for initSDK and file upload (Bearer).
PLAUD_ACCESS_TOKEN=

# Partner credentials for the transcription API (X-Client-* headers).
PLAUD_CLIENT_ID=
PLAUD_API_KEY=
